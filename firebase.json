{
  "hosting": {
    "site": "topherhooper-home",
    "public": "site",
    "ignore": ["**/.*"],
    "cleanUrls": true,
    "headers": [
      { "source": "**/*.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ],
    "rewrites": [
      { "source": "/api/session/**", "run": { "serviceId": "www-api", "region": "us-central1" } }
    ]
  }
}
